rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "admin1@admin.aa";
    }

    match /reviews/{reviewId} {
      // Public users may submit only a validated new review.
      allow create: if request.resource.data.keys().hasAll([
          "name", "message", "rating", "status", "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "name", "message", "rating", "status", "createdAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 50
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 1500
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.status == "new"
        && request.resource.data.createdAt == request.time;

      // Only the administrator can read, update, or delete reviews.
      allow read, update, delete: if isAdmin();
    }

    // Deny access to every collection not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}